+// Stop-string scan over the answer text (stateless chat requests). `visible` is how much of `text` may
+// be shown: everything before the earliest full match; and, unless `final_pass`, minus the longest tail
+// that is still a proper prefix of some stop string (it may yet become a match). `hit` is the index of the
+// stop string that matched, or -1. Monotone: text once visible stays visible as `text` grows, because a
+// prefix of a stop-prefix is itself a stop-prefix.
+struct StopScan {
+    size_t visible = 0;
+    int hit = -1;
+};
+StopScan scan_stops(const std::string & text, const std::vector<std::string> & stops, bool final_pass) {
+    StopScan r;
+    r.visible = text.size();
+    size_t best = std::string::npos;
+    for (size_t i = 0; i < stops.size(); ++i) {
+        if (stops[i].empty()) continue;
+        const size_t p = text.find(stops[i]);
+        if (p != std::string::npos && p < best) {
+            best = p;
+            r.hit = (int) i;
+        }
+    }
+    if (best != std::string::npos) {
+        r.visible = best;
+        return r;
+    }
+    if (!final_pass) {
+        size_t hold = 0;
+        for (const std::string & st : stops) {
+            if (st.size() < 2) continue;
+            const size_t kmax = std::min(st.size() - 1, text.size());
+            for (size_t k = kmax; k > hold; --k) {
+                if (text.compare(text.size() - k, k, st, 0, k) == 0) {
+                    hold = k;
+                    break;
+                }
+            }
+        }
+        r.visible = text.size() - hold;
+    }
+    return r;
+}
